rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // True until the owner's users/{uid}.profileComplete flips to true.
    // Lets the owner set locked fields (name, dob, department, etc.) for the
    // first time during onboarding — after that, only admins can.
    // A missing users/{uid} doc (e.g. the /register write never landed, or
    // a legacy/manually-created account) counts as "still onboarding" too —
    // otherwise get().data would throw on the missing doc, which denies the
    // *whole* rule and permanently locks that account out of onboarding.
    function isOnboardingInProgress(uid) {
      let path = /databases/$(database)/documents/users/$(uid);
      return !exists(path) || get(path).data.profileComplete == false;
    }

    // --- Free-tier replacement for the recalcProfileComplete Cloud Function ---
    // No Cloud Functions (Blaze plan) required: instead of trusting the client's
    // claim, we recompute completeness ourselves from the *actual* profiles/{uid}
    // doc already committed, so a user still can't spoof profileComplete from
    // devtools — they can only set it to the value this function independently
    // derives. Keep this in sync with isStepValid() in app/onboarding/page.jsx.
    function isAddressFilled(a) {
      return a != null && a.divisionId != null && a.districtId != null && a.upazilaId != null;
    }

    function isEmploymentFilled(e) {
      return e != null && e.status != null && (
        e.status == "studying" ||
        (
          e.jobType != null && (
            (e.jobType == "non-govt" && e.officeName != null && e.officeLocation != null) ||
            (e.jobType == "govt" && e.govtOrg != null && e.officeName != null)
          )
        )
      );
    }

    // Guards against a missing profiles/{uid} doc the same way as above —
    // without exists(), get().data on a doc that isn't there throws and the
    // caller (users/{uid}'s update rule) is denied outright.
    function computedProfileComplete(uid) {
      let path = /databases/$(database)/documents/profiles/$(uid);
      let p = exists(path) ? get(path).data : null;
      return p != null &&
        p.name != null && p.dob != null && p.bloodGroup != null && p.gender != null &&
        p.maritalStatus != null && p.phone != null &&
        p.department != null && p.session != null && p.passingYear != null &&
        isAddressFilled(p.permanentAddress) && isAddressFilled(p.currentAddress) &&
        isEmploymentFilled(p.employment);
    }


    // Fields a regular user is allowed to change on their own profile.
    // Everything else (name, dob, bloodGroup, gender, maritalStatus, department,
    // session, passingYear, finalYearRoll, permanentAddress) is admin-only.
    // donationCount/lastDonationDate: computed client-side by
    // lib/donationStats.js's recalcDonationStats() from the member's own
    // bloodDonations subcollection (which they already fully own per the
    // rule below) — not a Cloud Function, since this project may not be on
    // a Blaze plan. Low spoofing risk even so: these fields don't gate any
    // feature, unlike profileComplete, and a member already controls the
    // underlying donation records these are derived from.
    function onlyUserEditableFieldsChanged() {
      let allowed = ['currentAddress', 'phone', 'employment', 'visibility', 'photo', 'donationCount', 'lastDonationDate', 'updatedAt'];
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      // Can't self-assign the admin role at signup.
      allow create: if isOwner(uid) && request.resource.data.role == "user";
      // profileComplete: the owner may set it themselves right after finishing
      // onboarding, but ONLY to the value computedProfileComplete() derives
      // from their actual (already-committed) profiles/{uid} doc — so they
      // still can't hand-edit this to `true` in devtools with an empty profile.
      // Admins are restricted to 'role'/'profileComplete'/'updatedAt' so they
      // can't quietly rewrite someone's email from here.
      allow update: if
        (isOwner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt'])) ||
        (
          isOwner(uid) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['profileComplete', 'updatedAt']) &&
          request.resource.data.profileComplete == computedProfileComplete(uid)
        ) ||
        (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'profileComplete', 'updatedAt']));
      allow delete: if isAdmin();
    }

    match /profiles/{uid} {
      // Directory browsing needs read access to other users' profiles too —
      // visibility of individual fields (phone/email/etc.) is enforced client-side
      // via the `visibility` map, since Firestore rules can't redact fields.
      allow read: if isSignedIn();
      allow create: if isOwner(uid); // initial onboarding write
      allow update: if isAdmin()
        || (isOwner(uid) && isOnboardingInProgress(uid))
        || (isOwner(uid) && onlyUserEditableFieldsChanged());
      allow delete: if isAdmin();

      match /bloodDonations/{donationId} {
        allow read: if isSignedIn();
        allow write: if isOwner(uid) || isAdmin();
      }
    }

    match /users/{uid}/favorites/{favUid} {
      allow read, write: if isOwner(uid);
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false; // logs are immutable
    }

    match /config/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /settings/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // A notification is either a broadcast (audience == "all", visible to
    // everyone signed in) or targeted at one member (audience == "user",
    // targetUid == that member's uid). Only admins can create/edit/delete
    // them. "Read" state is per-member, so it can't live on this shared doc —
    // see users/{uid}/notificationReads below instead.
    match /notifications/{notifId} {
      allow read: if isSignedIn() &&
        (resource.data.audience == "all" || resource.data.targetUid == request.auth.uid || isAdmin());
      allow create: if isAdmin() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /users/{uid}/notificationReads/{notifId} {
      allow read, write: if isOwner(uid) || isAdmin();
    }
  }
}